{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-watermark-lab.example/schemas/handoff-v1.json",
  "title": "LLM Watermark Lab Step Handoff",
  "type": "object",
  "required": ["schema_version", "handoff_id", "task_id", "from_step", "to_step", "created_at", "inputs", "acceptance_gate"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "handoff_id": { "type": "string", "minLength": 1 },
    "task_id": { "pattern": "^T[0-9]{2}$" },
    "from_step": { "type": "string", "minLength": 1 },
    "to_step": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "open_findings": { "type": "array", "items": { "type": "string" } },
    "acceptance_gate": { "type": "string", "minLength": 1 },
    "instructions": { "type": "string" }
  },
  "additionalProperties": false
}
