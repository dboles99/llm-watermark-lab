{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-watermark-lab.example/schemas/finding-v1.json",
  "title": "LLM Watermark Lab Finding",
  "type": "object",
  "required": ["schema_version", "finding_id", "task_id", "severity", "status", "summary", "evidence", "created_at"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "finding_id": { "type": "string", "minLength": 1 },
    "task_id": { "pattern": "^T[0-9]{2}$" },
    "step_id": { "type": ["string", "null"] },
    "severity": { "enum": ["blocker", "high", "medium", "low", "info"] },
    "status": { "enum": ["open", "fixed", "accepted-with-test", "waived", "false-positive"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "description"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "recommended_action": { "type": ["string", "null"] },
    "waiver": {
      "type": ["object", "null"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["approved_by", "reason"],
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
