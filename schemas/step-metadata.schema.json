{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-watermark-lab.example/schemas/step-metadata-v1.json",
  "title": "LLM Watermark Lab Step Metadata",
  "type": "object",
  "required": ["schema_version", "task_id", "step_id", "status", "rosettas", "execution", "source", "inputs", "expected_outputs"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "task_id": { "pattern": "^T[0-9]{2}$" },
    "step_id": { "pattern": "^step-[0-9]{2}-[a-z0-9-]+$" },
    "status": { "enum": ["pending", "in-progress", "completed", "failed", "blocked", "superseded"] },
    "rosettas": { "type": "array", "items": { "$ref": "#/$defs/hashedPath" }, "minItems": 1 },
    "execution": {
      "type": "object",
      "required": ["execution_id", "role", "model", "started_at"],
      "properties": {
        "execution_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "required": ["provider", "model_id", "version"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model_id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "reasoning_effort": { "type": ["string", "null"] },
            "service_tier": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["git_commit", "working_tree_dirty", "environment"],
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "working_tree_dirty": { "type": "boolean" },
        "environment": { "type": "object" },
        "commands": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/hashedPath" } },
    "expected_outputs": { "type": "array", "items": { "$ref": "#/$defs/hashedPath" } },
    "findings": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  },
  "$defs": {
    "hashedPath": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
