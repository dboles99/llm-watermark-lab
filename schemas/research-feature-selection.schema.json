{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-watermark-lab.example/schemas/research-feature-selection-v1.json",
  "title": "LLM Watermark Lab Research Feature Selection",
  "type": "object",
  "required": [
    "schema_version",
    "selection_id",
    "selected_features",
    "execution_target",
    "execution_profile_id",
    "payload_identity_mode",
    "proof_backend",
    "locale",
    "created_at"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "selection_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "selected_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["edit-receipt", "polymark-demixing", "robust-fragile", "translingua-tw"]
      }
    },
    "execution_target": {"enum": ["api-first-hybrid", "local-only", "api-only"]},
    "execution_profile_id": {"const": "workstation-api-first"},
    "payload_identity_mode": {
      "enum": ["pseudonymous-project-workflow", "person-account-reference"]
    },
    "identity_reference": {
      "type": "object",
      "required": ["reference_id", "authority_record_id"],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^ref_[a-zA-Z0-9_-]{8,}$"},
        "authority_record_id": {"type": "string", "pattern": "^auth_[a-zA-Z0-9_-]{8,}$"}
      },
      "additionalProperties": false
    },
    "proof_backend": {"enum": ["tee-simulator", "remote-tee", "zero-knowledge"]},
    "locale": {"enum": ["en", "zh-Hant-TW"]},
    "target_locale": {"const": "zh-Hant-TW"},
    "created_at": {"type": "string", "format": "date-time"},
    "scientific_status": {"const": "selection-recorded-not-yet-promoted"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"payload_identity_mode": {"const": "person-account-reference"}},
        "required": ["payload_identity_mode"]
      },
      "then": {"required": ["identity_reference"]}
    },
    {
      "if": {
        "properties": {"selected_features": {"contains": {"const": "translingua-tw"}}},
        "required": ["selected_features"]
      },
      "then": {
        "required": ["target_locale"],
        "properties": {"target_locale": {"const": "zh-Hant-TW"}}
      }
    }
  ],
  "additionalProperties": false
}
